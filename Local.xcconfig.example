// Copy to Local.xcconfig (gitignored) and fill in your own values.
// Team ID: developer.apple.com → Account → Membership details → Team ID.
DEVELOPMENT_TEAM = REPLACE_WITH_YOUR_TEAM_ID
// Bundle id registered in App Store Connect; the iCloud container is iCloud.$(APP_BUNDLE_ID).
APP_BUNDLE_ID = com.example.gymbuddy
